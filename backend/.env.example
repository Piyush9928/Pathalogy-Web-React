PORT=5000
NODE_ENV=development

# PostgreSQL connection
PGHOST=localhost
PGPORT=5432
PGDATABASE=labsyncpro
PGUSER=postgres
PGPASSWORD=postgres

# JWT
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=8h

# --- Production (Render etc.) ---
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require   (used instead of the PG* values above)
# CORS_ORIGIN=https://your-web-app.onrender.com      (required when NODE_ENV=production; comma-separate several)
# JWT_SECRET must be 32+ random characters in production
# DEVELOPER_EMAIL / DEVELOPER_PASSWORD (10+ chars): first platform-owner account, created by `npm run bootstrap`
# UPLOAD_DIR=/var/data/uploads                       (persistent disk path for uploaded files)

# Security / lockout policy (mirrors appsettings.json Security section)
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
