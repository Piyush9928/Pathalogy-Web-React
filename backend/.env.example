PORT=5000
NODE_ENV=development

# PostgreSQL connection
PGHOST=localhost
PGPORT=5432
PGDATABASE=labsyncpro
PGUSER=postgres
PGPASSWORD=postgres

# JWT
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=8h

# Security / lockout policy (mirrors appsettings.json Security section)
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
